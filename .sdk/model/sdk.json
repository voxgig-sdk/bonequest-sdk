    "kit": {
      "info": {
        "contact": {
          "email": "root@bonequest.com"
        },
        "description": "The BoneQuest API provides access to episode data, allowing users to fetch details about episodes, including dialogue and metadata. It returns structured JSON responses for easy integration and use by developers.",
        "externalDocs": {
          "description": "API Documentation",
          "url": "https://github.com/bonequest/api"
        },
        "servers": [
          {
            "description": "Production server",
            "url": "https://www.bonequest.com/api/v2"
          }
        ],
        "title": "BoneQuest API",
        "version": "2.0.0",
        "tagline": "Fetch episode data, dialogue, and metadata from the BoneQuest webcomic archive",
        "homepage": "https://www.bonequest.com",
        "docs_url": "https://github.com/bonequest/api",
        "about_md": "[BoneQuest](https://www.bonequest.com) is a long-running web archive and community site that has been online since 1998. The site exposes a small public HTTP API (server version `bq/6.0.0`) for retrieving episode content, with source and reference material hosted at the [bonequest/api](https://github.com/bonequest/api) GitHub repository.\n\nWhat you get from the API:\n\n- Episode lookup by number, e.g. `GET /api/v2/episode/{number}` returns an episode with its dialogue and metadata.\n- Quote and search groupings, as exposed by this SDK's entity set.\n\nThe API is served from `https://www.bonequest.com/api/v2`. No authentication scheme, rate limits, or licence terms are documented on the project's public surfaces; CORS is reported as disabled by the community catalogue. For questions the site lists `root@bonequest.com` as a contact.",
        "entity_desc": {
          "episode": "A single BoneQuest episode identified by its number, returned with dialogue and metadata; example path `GET /api/v2/episode/{number}`.",
          "quote": "Quote-level resources drawn from episode dialogue.",
          "search": "Lookup operations for finding episodes or quotes across the archive."
        },
        "auth": false
      },
      "config": {
        "auth": {
          "prefix": "Bearer"
        },
        "headers": {
          "content-type": "application/json"
        },
        "docs_order": [
          "ts",
          "py",
          "php",
          "go",
          "rb",
          "lua"
        ]
      },
