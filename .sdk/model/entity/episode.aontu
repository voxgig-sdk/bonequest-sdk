# Entity: episode

main: kit: entity: episode: {

  alias: field: {}

  fields: {
    day: {
      h: "Day"
      n: "day"
      r: false
      sh: "Day of month published"
      t: "`$INTEGER`"
    }
    dialog: {
      h: "Dialog"
      n: "dialog"
      r: false
      sh: "Array of arrays containing episode dialog, element 0 is typically player's name and element 1 is the dialog"
      t: "`$ARRAY`"
    }
    episode: {
      h: "Episode"
      n: "episode"
      r: false
      sh: "Episode number"
      t: "`$INTEGER`"
    }
    hd: {
      h: "Hd"
      n: "hd"
      r: false
      sh: "Optional array containing details about associated BoneQuest HD images"
      t: "`$ARRAY`"
    }
    height: {
      h: "Height"
      n: "height"
      r: false
      sh: "Image height"
      t: "`$INTEGER`"
    }
    hifi: {
      h: "Hifi"
      n: "hifi"
      r: false
      sh: "Optional details about an associated BoneQuest HiFi episode"
      t: "`$OBJECT`"
    }
    image: {
      h: "Image"
      n: "image"
      r: false
      sh: "Partial URL to episode image"
      t: "`$STRING`"
    }
    month: {
      h: "Month"
      n: "month"
      r: false
      sh: "Month published, number between 1-12"
      t: "`$INTEGER`"
    }
    navigation: {
      h: "Navigation"
      n: "navigation"
      r: false
      sh: "Back and next keys contain fully-formed episode for surrounding episodes"
      t: "`$OBJECT`"
    }
    players: {
      h: "Players"
      n: "players"
      r: false
      sh: "Array of player names"
      t: "`$ARRAY`"
    }
    tags: {
      h: "Tags"
      n: "tags"
      r: false
      sh: "Array of tags applied"
      t: "`$ARRAY`"
    }
    thumb: {
      h: "Thumb"
      n: "thumb"
      r: false
      sh: "Partial URL to thumbnail of episode image"
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "Episode title"
      t: "`$STRING`"
    }
    width: {
      h: "Width"
      n: "width"
      r: false
      sh: "Image width"
      t: "`$INTEGER`"
    }
    year: {
      h: "Year"
      n: "year"
      r: false
      sh: "Year published"
      t: "`$INTEGER`"
    }
  }

  name: "episode"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /episodes/random/{count}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: 1
                k: "param"
                n: "count"
                or: "count"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/episodes/random/{count}"
          q: {
            exist: [
              "count"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "episodes"
            }
            {
              lit: "random"
            }
            {
              var: "count"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.episodes`"
          }
        }
        {
          co: {
            id: "GET /episode/{episodeNumber}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: 420
                k: "param"
                n: "episode_number"
                or: "episodeNumber"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/episode/{episodeNumber}"
          q: {
            exist: [
              "episode_number"
            ]
          }
          r: {
            param: {
              episodeNumber: "episode_number"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "episode"
            }
            {
              var: "episode_number"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.episodes`"
          }
        }
        {
          co: {
            id: "GET /episodes/{episodeNumbers}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "666,667"
                k: "param"
                n: "episode_number"
                or: "episodeNumbers"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/episodes/{episodeNumbers}"
          q: {
            exist: [
              "episode_number"
            ]
          }
          r: {
            param: {
              episodeNumbers: "episode_number"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "episodes"
            }
            {
              var: "episode_number"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.episodes`"
          }
        }
      ]
    }
  }



}
